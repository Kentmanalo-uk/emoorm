# Local environment and generated upload files
**/.env
**/.env.*
# Env files named like production.env (secrets for the host's settings).
*.env
!**/.env.example
backend/uploads/
backend/uploads-private/
# A copy of the live site's uploads (payment receipts and chat photos
# among them): kept on this PC, never in the public repo.
production-uploads/
.claude/

# The Android app's project (built and signed on this PC; its signing key
# lives in apk/keystore/). The site offers the finished APK from
# web/public/downloads/ (apk/publish.cjs puts it there).
apk/

# Kept on this PC only, not part of the app: media/ (banners, posts,
# videos and their engine; see media/README.md) except the Play Store
# listing (the logo sources are media/brand/logos), docs/private/ (manuals,
# decks, notes, screenshots) and the sister project. docs/ itself (deployment, hosting,
# handoff, overview) is in git.
/media/*
!/media/store-listing/
docs/private/
/moormove/
# Moved into media/ and docs/ on 8 Nov 2026 (media/MOVES.md); listed while
# anything is left behind in them.
documentation/
graphics/
ppt/
