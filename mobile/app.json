{
  "expo": {
    "name": "E-MOORM",
    "slug": "emoorm",
    "scheme": [
      "emoorm",
      "shop.emoorm.app"
    ],
    "version": "2.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "extra": {
      "apiBaseUrl": "http://10.0.2.2:3000/api",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "f2ec5c6a-973d-46d9-80ad-70527d300a48"
      },
      "googleWebClientId": "525462391540-idk8hit6qrd139poqu61k5tt4qauga6h.apps.googleusercontent.com",
      "googleAndroidClientId": "525462391540-s7cggmdnog0i3bvsttfq46qftlalqkn2.apps.googleusercontent.com"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emoorm.marketplace",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "E-MOORM uses your photos for product images, payment proof, profile photos, and reviews.",
        "NSCameraUsageDescription": "E-MOORM uses the camera for image search and marketplace uploads.",
        "NSPhotoLibraryAddUsageDescription": "E-MOORM saves your shop's QR poster to your photos when you ask."
      },
      "icon": "./assets/app.icon"
    },
    "android": {
      "package": "shop.emoorm.app",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#055D07",
        "backgroundImage": "./assets/android-icon-background.png",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "versionCode": 23,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "emoorm.shop"
            },
            {
              "scheme": "https",
              "host": "www.emoorm.shop"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "./plugins/withOptionalHardware",
      "expo-status-bar",
      "expo-font",
      "expo-video",
      [
        "expo-camera",
        {
          "cameraPermission": "E-MOORM uses the camera to scan QR codes for login and image search."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "E-MOORM shows your recent photos so you can search for products by image.",
          "savePhotosPermission": "E-MOORM saves your shop's QR poster to your photos when you ask.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "E-MOORM uses your location to show the way to a shop's pickup spot and to pin your delivery address."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-image",
      "expo-sharing",
      "@react-native-google-signin/google-signin"
    ],
    "owner": "devbymikes-team"
  }
}
