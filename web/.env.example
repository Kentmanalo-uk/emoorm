# Copy to .env for local development. Production build values live in
# .env.production, which Vite loads automatically during `vite build`.

# Where the API lives. In development the backend runs on its own port; in
# production it is the same origin, so .env.production uses a relative /api.
VITE_API_URL=http://localhost:3000/api

VITE_APP_NAME=E-MOORM
VITE_APP_DESCRIPTION=Shop local from Oriental Mindoro

# Public by design — the matching secret stays on the backend.
VITE_GOOGLE_CLIENT_ID=
