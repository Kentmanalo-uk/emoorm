// E-MOORM Database Schema
// E-Commerce Platform for Oriental Mindoro

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  BUYER
  SELLER
  MUNICIPAL_ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  HIDDEN
  SUSPENDED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  TO_SHIP
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_PICKUP
  PICKED_UP
}

enum FulfillmentMode {
  DELIVERY
  PICKUP
  BOTH
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  GCASH
  QRPH
  BANK_TRANSFER
}

enum ReportType {
  PRODUCT
  SELLER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  ORDER_RECEIVED
  ORDER_CONFIRMED
  ORDER_READY
  ORDER_COMPLETED
  ORDER_CANCELLED
  PRODUCT_APPROVED
  PRODUCT_SUSPENDED
  SELLER_APPROVED
  SELLER_SUSPENDED
  REPORT_SUBMITTED
  REPORT_RESOLVED
  SYSTEM_ANNOUNCEMENT
  STORE_NEW_PRODUCT
  STORE_PROMOTION
  STORE_ANNOUNCEMENT
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  fullName      String    @map("full_name")
  contactNumber String?   @map("contact_number")
  profilePhoto  String?   @map("profile_photo")

  // Location
  municipalityId String   @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  barangay      String?
  address       String?   @db.Text

  // Role and Status
  role          UserRole  @default(BUYER)
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")

  // Seller Application
  sellerApplicationStatus String?   @map("seller_application_status")
  sellerApplicationDate   DateTime? @map("seller_application_date")
  shopName                String?   @map("shop_name")
  shopDescription         String?   @map("shop_description") @db.Text
  shopAddress             String?   @map("shop_address")
  idType                  String?   @map("id_type")
  idFrontUrl              String?   @map("id_front_url")
  idBackUrl               String?   @map("id_back_url")
  selfieUrl               String?   @map("selfie_url")

  // Password Reset
  passwordResetToken  String?   @map("password_reset_token")
  passwordResetExpiry DateTime? @map("password_reset_expiry")

  // MFA / TOTP (enforced for admins)
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret") @db.Text
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  mfaBackupCodes   String?   @map("mfa_backup_codes") @db.Text
  mfaLastVerifiedAt DateTime? @map("mfa_last_verified_at")

  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  store         Store?
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  notifications Notification[]
  reports       Report[]
  managedMunicipality Municipality? @relation("MunicipalAdmin")
  buyerConversations Conversation[] @relation("BuyerConversations")
  sentMessages  Message[]      @relation("MessageSender")
  followedStores StoreFollow[]

  @@map("users")
}

model Municipality {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  isActive  Boolean  @default(true) @map("is_active")

  // Admin Assignment
  adminId   String?  @unique @map("admin_id")
  admin     User?    @relation("MunicipalAdmin", fields: [adminId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users     User[]
  stores    Store[]
  products  Product[]
  reports   Report[]
  serviceAreas StoreServiceArea[]

  @@map("municipalities")
}

model Store {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  logo          String?
  coverImage    String?  @map("cover_image")
  businessHours String?  @db.Text @map("business_hours")

  // Owner
  ownerId       String   @unique @map("owner_id")
  owner         User     @relation(fields: [ownerId], references: [id])

  // Location
  municipalityId String  @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // Fulfillment settings
  fulfillmentMode      FulfillmentMode @default(DELIVERY) @map("fulfillment_mode")
  pickupAddress        String?         @db.Text @map("pickup_address")
  pickupInstructions   String?         @db.Text @map("pickup_instructions")

  // Payment settings
  paymentQrImage       String?         @map("payment_qr_image")
  paymentQrType        String?         @map("payment_qr_type")
  paymentInstructions  String?         @db.Text @map("payment_instructions")
  acceptsCod           Boolean         @default(true) @map("accepts_cod")

  // Theme customization
  primaryColor         String?         @map("primary_color")
  secondaryColor       String?         @map("secondary_color")
  bannerImage          String?         @map("banner_image")

  // Status
  isActive      Boolean  @default(true) @map("is_active")
  isSuspended   Boolean  @default(false) @map("is_suspended")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  products      Product[]
  orders        Order[]
  conversations Conversation[]
  serviceAreas  StoreServiceArea[]
  followers     StoreFollow[]

  @@map("stores")
}

model StoreFollow {
  id                    String   @id @default(uuid())
  buyerId               String   @map("buyer_id")
  storeId               String   @map("store_id")
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  createdAt             DateTime @default(now()) @map("created_at")

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([buyerId, storeId])
  @@index([storeId])
  @@index([buyerId])
  @@map("store_follows")
}

model StoreServiceArea {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  municipalityId String   @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  barangay       String?  // null means "all barangays in this municipality"

  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([storeId, municipalityId, barangay])
  @@index([storeId])
  @@index([municipalityId])
  @@map("store_service_areas")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  image       String?
  isActive    Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  products    Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  stock       Int           @default(0)
  images      Json          // Array of image URLs
  imageHash   String?       @map("image_hash") @db.VarChar(16)

  // Ownership
  storeId     String        @map("store_id")
  store       Store         @relation(fields: [storeId], references: [id])

  // Category
  categoryId  String        @map("category_id")
  category    Category      @relation(fields: [categoryId], references: [id])

  // Location
  municipalityId String     @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // Status
  status      ProductStatus @default(PENDING)

  // Approval Audit
  approvedById String?      @map("approved_by_id")
  approvedAt   DateTime?    @map("approved_at")

  // Soft Delete
  deletedAt   DateTime?     @map("deleted_at")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  orderItems  OrderItem[]
  reviews     Review[]
  wishlistItems WishlistItem[]
  cartItems   CartItem[]
  reports     Report[]

  @@map("products")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")

  // Buyer
  buyerId         String      @map("buyer_id")
  buyer           User        @relation(fields: [buyerId], references: [id])

  // Store
  storeId         String      @map("store_id")
  store           Store       @relation(fields: [storeId], references: [id])

  // Totals
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  total           Decimal     @db.Decimal(10, 2)

  // Status
  status          OrderStatus @default(PENDING)

  // Fulfillment
  fulfillmentMethod FulfillmentMethod @default(DELIVERY) @map("fulfillment_method")
  pickupLocation    String?           @db.Text @map("pickup_location")

  // Payment
  paymentMethod    PaymentMethod @default(COD) @map("payment_method")
  paymentReference String?       @map("payment_reference")
  paymentProofUrl  String?       @map("payment_proof_url")

  // Delivery Information
  deliveryAddress String      @db.Text @map("delivery_address")
  deliveryNotes   String?     @db.Text @map("delivery_notes")
  contactNumber   String      @map("contact_number")

  // Buyer address parts (for coverage/receipts)
  buyerMunicipalityId String? @map("buyer_municipality_id")
  buyerBarangay       String? @map("buyer_barangay")

  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  completedAt     DateTime?   @map("completed_at")
  cancelledAt     DateTime?   @map("cancelled_at")

  // Relations
  items           OrderItem[]
  messages        Message[]

  @@map("orders")
}

model OrderItem {
  id            String   @id @default(uuid())

  orderId       String   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id])

  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])

  // Price Snapshot (never changes)
  productName   String   @map("product_name")
  price         Decimal  @db.Decimal(10, 2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(10, 2)

  createdAt     DateTime @default(now()) @map("created_at")

  @@map("order_items")
}

model CartItem {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  rating    Int      // 1-5
  comment   String?  @db.Text

  images    Json?    // Array of image URLs
  videoUrl  String?  @map("video_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("reviews")
}

model Report {
  id            String       @id @default(uuid())

  // Reporter
  reporterId    String       @map("reporter_id")
  reporter      User         @relation(fields: [reporterId], references: [id])

  // Type and Target
  type          ReportType
  productId     String?      @map("product_id")
  product       Product?     @relation(fields: [productId], references: [id])
  reportedSellerId String?   @map("reported_seller_id")

  // Content
  reason        String       @db.Text
  description   String?      @db.Text
  evidence      Json?        // Array of evidence URLs

  // Status
  status        ReportStatus @default(PENDING)

  // Municipality Routing
  municipalityId String      @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // Resolution
  resolutionNotes String?    @db.Text @map("resolution_notes")
  resolvedAt      DateTime?  @map("resolved_at")

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("reports")
}

model Notification {
  id        String           @id @default(uuid())

  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])

  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?            // Additional data payload
  relatedId String?          @map("related_id")

  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")

  createdAt DateTime         @default(now()) @map("created_at")
  deletedAt DateTime?        @map("deleted_at")

  @@map("notifications")
}

// ============================================
// AUDIT LOG (Optional but recommended)
// ============================================

model AuditLog {
  id        String   @id @default(uuid())

  userId    String?  @map("user_id")
  userEmail String?  @map("user_email")

  action    String   // e.g., "CREATE_PRODUCT", "APPROVE_SELLER"
  entity    String   // e.g., "Product", "User"
  entityId  String?  @map("entity_id")

  details   Json?    // Additional context
  ipAddress String?  @map("ip_address")
  userAgent String?  @db.Text @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("audit_logs")
}

// ============================================
// MESSAGING (buyer <-> store)
// ============================================

model Conversation {
  id        String   @id @default(uuid())

  buyerId   String   @map("buyer_id")
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id])

  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id])

  lastMessageAt    DateTime? @map("last_message_at")
  buyerLastReadAt  DateTime? @map("buyer_last_read_at")
  sellerLastReadAt DateTime? @map("seller_last_read_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages  Message[]

  @@unique([buyerId, storeId])
  @@index([storeId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId  String   @map("sender_id")
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  body      String   @db.Text

  // Optional link to an order this message references (used for auto-pinned order cards)
  orderId   String?  @map("order_id")
  order     Order?   @relation(fields: [orderId], references: [id])

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}
