// E-MOORM Database Schema
// E-Commerce Platform for Oriental Mindoro

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model AppSetting {
  id                 String   @id @default("global")
  appLogo            String   @default("/brand-icon.png") @map("app_logo")
  productPlaceholder String   @default("/brand-icon.png") @map("product_placeholder")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  BUYER
  SELLER
  MUNICIPAL_ADMIN
  SUPER_ADMIN
}

enum ProductStatus {
  PENDING
  APPROVED
  HIDDEN
  SUSPENDED
  ARCHIVED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  COMPLETED
  CANCELLED
  TO_SHIP
  OUT_FOR_DELIVERY
  DELIVERED
  READY_FOR_PICKUP
  PICKED_UP
}

enum FulfillmentMode {
  DELIVERY
  PICKUP
  BOTH
}

enum FulfillmentMethod {
  DELIVERY
  PICKUP
}

enum PaymentMethod {
  COD
  GCASH
  QRPH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PENDING_VERIFICATION
  PAID
  FAILED
  EXPIRED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum ReportType {
  PRODUCT
  SELLER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum NotificationType {
  ORDER_RECEIVED
  ORDER_CONFIRMED
  ORDER_READY
  ORDER_COMPLETED
  ORDER_CANCELLED
  PRODUCT_APPROVED
  PRODUCT_SUSPENDED
  SELLER_APPROVED
  SELLER_SUSPENDED
  REPORT_SUBMITTED
  REPORT_RESOLVED
  SYSTEM_ANNOUNCEMENT
  STORE_NEW_PRODUCT
  STORE_PROMOTION
  STORE_ANNOUNCEMENT
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURN_AWAITING_SHIPMENT
  RETURN_RECEIVED
  RETURN_REFUNDED
  RETURN_CANCELLED
  RETURN_CLOSED
  SUPPORT_MESSAGE
  SELLER_APPLICATION_SUBMITTED
  ADMIN_ALERT
}

enum NotificationAudience {
  BUYER
  SELLER
  ADMIN
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  AWAITING_SHIPMENT
  RECEIVED
  REFUNDED
  REJECTED
  CANCELLED
  CLOSED
}

enum ReturnReason {
  DAMAGED
  WRONG_ITEM
  NOT_AS_DESCRIBED
  MISSING
  OTHER
}

enum RefundMethod {
  COD_CASH
  GCASH
  BANK
  MANUAL
}

enum QrLoginStatus {
  PENDING
  SCANNED
  APPROVED
  REJECTED
  EXPIRED
}

enum SupportTicketType {
  CUSTOMER_CARE
  FEEDBACK
}

enum SupportTicketStatus {
  OPEN
  IN_REVIEW
  CLOSED
}

// ============================================
// CORE MODELS
// ============================================

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String
  fullName      String    @map("full_name")
  contactNumber String?   @map("contact_number")
  profilePhoto  String?   @map("profile_photo")

  // Google OAuth linkage (nullable — populated when the user signs in via Google).
  googleId      String?   @unique @map("google_id")

  // Location (Philippine address hierarchy)
  province      String?  @default("Oriental Mindoro")
  municipalityId String   @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  barangay      String?
  address       String?   @db.Text

  // Role and Status
  role          UserRole  @default(BUYER)
  isActive      Boolean   @default(true) @map("is_active")
  isVerified    Boolean   @default(false) @map("is_verified")

  // Seller Application
  sellerApplicationStatus String?   @map("seller_application_status")
  sellerApplicationDate   DateTime? @map("seller_application_date")
  shopName                String?   @map("shop_name")
  shopDescription         String?   @map("shop_description") @db.Text
  shopAddress             String?   @map("shop_address")
  idType                  String?   @map("id_type")
  idFrontUrl              String?   @map("id_front_url")
  idBackUrl               String?   @map("id_back_url")
  selfieUrl               String?   @map("selfie_url")

  // Password Reset
  passwordResetToken  String?   @map("password_reset_token")
  passwordResetExpiry DateTime? @map("password_reset_expiry")

  // MFA / TOTP (enforced for admins)
  mfaEnabled       Boolean   @default(false) @map("mfa_enabled")
  mfaSecret        String?   @map("mfa_secret") @db.Text
  mfaEnabledAt     DateTime? @map("mfa_enabled_at")
  mfaBackupCodes   String?   @map("mfa_backup_codes") @db.Text
  mfaLastVerifiedAt DateTime? @map("mfa_last_verified_at")

  // Temporary (backup) municipal admins lose admin access after this time.
  adminAccessExpiresAt DateTime? @map("admin_access_expires_at")

  // Timestamps
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  store         Store?
  orders        Order[]
  reviews       Review[]
  wishlistItems WishlistItem[]
  cartItems     CartItem[]
  notifications Notification[]
  reports       Report[]
  managedMunicipality Municipality? @relation("MunicipalAdmin")
  buyerConversations Conversation[] @relation("BuyerConversations")
  sentMessages  Message[]      @relation("MessageSender")
  followedStores StoreFollow[]
  addresses     Address[]
  qrLoginSessions QrLoginSession[]
  pushTokens    PushToken[]
  returnRequests ReturnRequest[] @relation("BuyerReturns")
  supportTickets SupportTicket[]
  supportConversations SupportConversation[]
  supportMessages SupportMessage[]
  bannersCreated Banner[]         @relation("BannerCreator")
  vouchersCreated Voucher[]       @relation("VoucherCreator")
  voucherRedemptions VoucherRedemption[]
  identityVerification IdentityVerification?

  @@map("users")
}

enum IdentityVerificationStatus {
  NOT_VERIFIED
  PENDING
  VERIFIED
  FAILED
}

// Buyer identity verification (OCR of a Philippine government ID).
// Kept separate from User so it never leaks through profile queries.
// The ID image itself is never stored; extracted fields are AES-256-GCM
// encrypted and the ID number is only kept as a keyed hash (reuse check).
model IdentityVerification {
  id            String                     @id @default(uuid())
  userId        String                     @unique @map("user_id")
  user          User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        IdentityVerificationStatus @default(NOT_VERIFIED)
  idType        String?                    @map("id_type")
  encryptedData String?                    @db.Text @map("encrypted_data")
  idNumberHash  String?                    @unique @map("id_number_hash")
  failureReason String?                    @db.Text @map("failure_reason")
  attemptCount  Int                        @default(0) @map("attempt_count")
  lastAttemptAt DateTime?                  @map("last_attempt_at")
  verifiedAt    DateTime?                  @map("verified_at")
  // Set when an admin verifies/rejects manually (e.g. after an in-person ID check).
  reviewedById  String?                    @map("reviewed_by_id")
  reviewNote    String?                    @db.Text @map("review_note")
  createdAt     DateTime                   @default(now()) @map("created_at")
  updatedAt     DateTime                   @updatedAt @map("updated_at")

  @@map("identity_verifications")
}

model SupportTicket {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        SupportTicketType
  category    String
  subject     String
  message     String              @db.Text
  rating      Int?
  status      SupportTicketStatus @default(OPEN)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([type, status])
  @@map("support_tickets")
}

// Help chat between a user and their municipality's admin (e.g. identity
// verification problems). Separate from buyer–store messaging.
enum SupportConversationStatus {
  OPEN
  CLOSED
}

model SupportConversation {
  id              String                    @id @default(uuid())
  userId          String                    @map("user_id")
  user            User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  municipalityId  String                    @map("municipality_id")
  municipality    Municipality              @relation(fields: [municipalityId], references: [id])
  topic           String                    @default("GENERAL")
  status          SupportConversationStatus @default(OPEN)
  lastMessageAt   DateTime?                 @map("last_message_at")
  userLastReadAt  DateTime?                 @map("user_last_read_at")
  adminLastReadAt DateTime?                 @map("admin_last_read_at")
  createdAt       DateTime                  @default(now()) @map("created_at")
  updatedAt       DateTime                  @updatedAt @map("updated_at")
  messages        SupportMessage[]

  @@unique([userId, municipalityId])
  @@index([municipalityId, lastMessageAt])
  @@map("support_conversations")
}

model SupportMessage {
  id             String              @id @default(uuid())
  conversationId String              @map("conversation_id")
  conversation   SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String              @map("sender_id")
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String              @db.Text
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("support_messages")
}

model Address {
  id            String   @id @default(uuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label         String?
  fullName      String   @map("full_name")
  contactNumber String   @map("contact_number")

  // Philippine address hierarchy: Province -> City/Municipality -> Barangay -> Street
  province      String?  @default("Oriental Mindoro")
  municipalityId String  @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  barangay      String
  street        String   @db.Text

  isDefault     Boolean  @default(false) @map("is_default")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("addresses")
}

model QrLoginSession {
  id            String        @id @default(uuid())
  token         String        @unique
  status        QrLoginStatus @default(PENDING)

  userId        String?       @map("user_id")
  user          User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  deviceLabel   String?       @map("device_label")
  userAgent     String?       @map("user_agent") @db.Text
  ipAddress     String?       @map("ip_address")

  // Populated only once approved; consumed (and the row deleted) on first
  // successful poll from the web client — never reused.
  accessToken   String?       @db.Text @map("access_token")
  refreshToken  String?       @db.Text @map("refresh_token")

  createdAt     DateTime      @default(now()) @map("created_at")
  expiresAt     DateTime      @map("expires_at")
  scannedAt     DateTime?     @map("scanned_at")
  approvedAt    DateTime?     @map("approved_at")

  @@map("qr_login_sessions")
}

model Municipality {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String   @unique
  logo      String?
  tagline   String? @db.VarChar(180)
  description String? @db.Text
  gallery   Json?
  isActive  Boolean  @default(true) @map("is_active")

  // Admin Assignment
  adminId   String?  @unique @map("admin_id")
  admin     User?    @relation("MunicipalAdmin", fields: [adminId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users     User[]
  stores    Store[]
  products  Product[]
  reports   Report[]
  serviceAreas StoreServiceArea[]
  addresses Address[]
  supportConversations SupportConversation[]

  @@map("municipalities")
}

model Store {
  id            String   @id @default(uuid())
  name          String
  slug          String   @unique
  description   String?  @db.Text
  logo          String?
  coverImage    String?  @map("cover_image")
  businessHours String?  @db.Text @map("business_hours")

  // Owner
  ownerId       String   @unique @map("owner_id")
  owner         User     @relation(fields: [ownerId], references: [id])

  // Location (Philippine address hierarchy)
  province       String?  @default("Oriental Mindoro")
  municipalityId String  @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  latitude       Float?
  longitude      Float?

  // Fulfillment settings
  fulfillmentMode      FulfillmentMode @default(DELIVERY) @map("fulfillment_mode")
  pickupAddress        String?         @db.Text @map("pickup_address")
  pickupInstructions   String?         @db.Text @map("pickup_instructions")

  // Payment settings
  paymentQrImage       String?         @map("payment_qr_image")
  paymentQrType        String?         @map("payment_qr_type")
  paymentInstructions  String?         @db.Text @map("payment_instructions")
  acceptsCod           Boolean         @default(true) @map("accepts_cod")

  // Theme customization
  primaryColor         String?         @map("primary_color")
  secondaryColor       String?         @map("secondary_color")
  bannerImage          String?         @map("banner_image")

  // Status
  isActive      Boolean  @default(true) @map("is_active")
  isSuspended   Boolean  @default(false) @map("is_suspended")
  suspensionReason String? @db.Text @map("suspension_reason")

  // Deletion grace period — set when the seller requests deletion; store is
  // hidden immediately and permanently deleted 15 days later unless cancelled
  deletionRequestedAt DateTime? @map("deletion_requested_at")

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  // Relations
  products      Product[]
  orders        Order[]
  conversations Conversation[]
  serviceAreas  StoreServiceArea[]
  followers     StoreFollow[]
  returnRequests ReturnRequest[] @relation("StoreReturns")

  @@map("stores")
}

model StoreFollow {
  id                    String   @id @default(uuid())
  buyerId               String   @map("buyer_id")
  storeId               String   @map("store_id")
  notificationsEnabled  Boolean  @default(true) @map("notifications_enabled")
  createdAt             DateTime @default(now()) @map("created_at")

  buyer User  @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  store Store @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([buyerId, storeId])
  @@index([storeId])
  @@index([buyerId])
  @@map("store_follows")
}

model StoreServiceArea {
  id             String   @id @default(uuid())
  storeId        String   @map("store_id")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  municipalityId String   @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])
  barangay       String?  // null means "all barangays in this municipality"

  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([storeId, municipalityId, barangay])
  @@index([storeId])
  @@index([municipalityId])
  @@map("store_service_areas")
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?   @db.Text
  image       String?
  isActive    Boolean   @default(true) @map("is_active")

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  products    Product[]

  @@map("categories")
}

model Product {
  id          String        @id @default(uuid())
  name        String
  slug        String        @unique
  description String        @db.Text
  price       Decimal       @db.Decimal(10, 2)
  stock       Int           @default(0)
  lowStockThreshold Int     @default(5) @map("low_stock_threshold")
  images      Json          // Array of image URLs
  returnPolicy Json?        @map("return_policy")
  variations  Json?
  imageHash   String?       @map("image_hash") @db.VarChar(16)

  // Ownership
  storeId     String        @map("store_id")
  store       Store         @relation(fields: [storeId], references: [id])

  // Category
  categoryId  String        @map("category_id")
  category    Category      @relation(fields: [categoryId], references: [id])

  // Location
  municipalityId String     @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // Status
  status      ProductStatus @default(PENDING)
  moderationNote String?    @db.Text @map("moderation_note")

  // Approval Audit
  approvedById String?      @map("approved_by_id")
  approvedAt   DateTime?    @map("approved_at")

  // Soft Delete
  deletedAt   DateTime?     @map("deleted_at")

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  orderItems  OrderItem[]
  reviews     Review[]
  wishlistItems WishlistItem[]
  cartItems   CartItem[]
  reports     Report[]
  messages    Message[]
  inventoryMovements InventoryMovement[]

  @@map("products")
}

model InventoryMovement {
  id           String   @id @default(uuid())
  productId    String   @map("product_id")
  product      Product  @relation(fields: [productId], references: [id])
  quantityDelta Int     @map("quantity_delta")
  balanceAfter Int      @map("balance_after")
  reason       String
  referenceId  String?  @map("reference_id")
  actorId      String?  @map("actor_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([productId, createdAt])
  @@index([referenceId])
  @@map("inventory_movements")
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique @map("order_number")
  checkoutKey     String?     @map("checkout_key")

  // Buyer
  buyerId         String      @map("buyer_id")
  buyer           User        @relation(fields: [buyerId], references: [id])

  // Store
  storeId         String      @map("store_id")
  store           Store       @relation(fields: [storeId], references: [id])

  // Totals
  subtotal        Decimal     @db.Decimal(10, 2)
  deliveryFee     Decimal     @default(0) @db.Decimal(10, 2) @map("delivery_fee")
  discountAmount  Decimal     @default(0) @db.Decimal(10, 2) @map("discount_amount")
  voucherCode     String?     @map("voucher_code")
  voucherId       String?     @map("voucher_id")
  voucher         Voucher?    @relation(fields: [voucherId], references: [id])
  total           Decimal     @db.Decimal(10, 2)

  // Status
  status          OrderStatus @default(PENDING)

  // Fulfillment
  fulfillmentMethod FulfillmentMethod @default(DELIVERY) @map("fulfillment_method")
  pickupLocation    String?           @db.Text @map("pickup_location")

  // Payment
  paymentMethod    PaymentMethod @default(COD) @map("payment_method")
  paymentStatus    PaymentStatus @default(PENDING) @map("payment_status")
  paymentReference String?       @map("payment_reference")
  paymentProofUrl  String?       @map("payment_proof_url")

  // Delivery Information
  deliveryAddress String      @db.Text @map("delivery_address")
  deliveryNotes   String?     @db.Text @map("delivery_notes")
  contactNumber   String      @map("contact_number")

  // Buyer address parts (for coverage/receipts)
  buyerProvince       String? @default("Oriental Mindoro") @map("buyer_province")
  buyerMunicipalityId String? @map("buyer_municipality_id")
  buyerBarangay       String? @map("buyer_barangay")

  // Timestamps
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  completedAt     DateTime?   @map("completed_at")
  cancelledAt     DateTime?   @map("cancelled_at")

  // Relations
  items           OrderItem[]
  messages        Message[]
  returnRequests  ReturnRequest[] @relation("OrderReturns")
  statusHistory   OrderStatusHistory[]
  voucherRedemption VoucherRedemption?

  @@index([buyerId, checkoutKey])
  @@map("orders")
}

model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String      @map("order_id")
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus  OrderStatus? @map("from_status")
  toStatus    OrderStatus  @map("to_status")
  actorId     String?     @map("actor_id")
  note        String?     @db.Text
  createdAt   DateTime    @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@map("order_status_history")
}

model OrderItem {
  id            String   @id @default(uuid())

  orderId       String   @map("order_id")
  order         Order    @relation(fields: [orderId], references: [id])

  productId     String   @map("product_id")
  product       Product  @relation(fields: [productId], references: [id])

  // Price Snapshot (never changes)
  productName   String   @map("product_name")
  price         Decimal  @db.Decimal(10, 2)
  quantity      Int
  subtotal      Decimal  @db.Decimal(10, 2)
  selectedVariations Json? @map("selected_variations")
  returnPolicySnapshot Json? @map("return_policy_snapshot")

  createdAt     DateTime @default(now()) @map("created_at")

  returnRequestItems ReturnRequestItem[] @relation("OrderItemReturns")

  @@map("order_items")
}

model CartItem {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  quantity  Int      @default(1)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@map("wishlist_items")
}

model Review {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id])

  productId String   @map("product_id")
  product   Product  @relation(fields: [productId], references: [id])

  rating    Int      // 1-5
  comment   String?  @db.Text

  images    Json?    // Array of image URLs
  videoUrl  String?  @map("video_url")

  sellerReply     String?   @db.Text @map("seller_reply")
  sellerRepliedAt DateTime? @map("seller_replied_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@map("reviews")
}

model Report {
  id            String       @id @default(uuid())

  // Reporter
  reporterId    String       @map("reporter_id")
  reporter      User         @relation(fields: [reporterId], references: [id])

  // Type and Target
  type          ReportType
  productId     String?      @map("product_id")
  product       Product?     @relation(fields: [productId], references: [id])
  reportedSellerId String?   @map("reported_seller_id")

  // Content
  reason        String       @db.Text
  description   String?      @db.Text
  evidence      Json?        // Array of evidence URLs

  // Status
  status        ReportStatus @default(PENDING)

  // Municipality Routing
  municipalityId String      @map("municipality_id")
  municipality   Municipality @relation(fields: [municipalityId], references: [id])

  // Resolution
  resolutionNotes String?    @db.Text @map("resolution_notes")
  resolvedAt      DateTime?  @map("resolved_at")

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@map("reports")
}

model Notification {
  id        String           @id @default(uuid())

  userId    String           @map("user_id")
  user      User             @relation(fields: [userId], references: [id])

  type      NotificationType
  audience  NotificationAudience @default(BUYER)
  title     String
  message   String           @db.Text
  data      Json?            // Additional data payload
  relatedId String?          @map("related_id")

  isRead    Boolean          @default(false) @map("is_read")
  readAt    DateTime?        @map("read_at")

  createdAt DateTime         @default(now()) @map("created_at")
  deletedAt DateTime?        @map("deleted_at")

  @@map("notifications")
}

model PushToken {
  id        String   @id @default(uuid())

  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  token     String   @unique
  platform  String?  // 'ios' | 'android' | 'web'

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("push_tokens")
}

// ============================================
// AUDIT LOG (Optional but recommended)
// ============================================

model AuditLog {
  id        String   @id @default(uuid())

  userId    String?  @map("user_id")
  userEmail String?  @map("user_email")

  action    String   // e.g., "CREATE_PRODUCT", "APPROVE_SELLER"
  entity    String   // e.g., "Product", "User"
  entityId  String?  @map("entity_id")

  details   Json?    // Additional context
  ipAddress String?  @map("ip_address")
  userAgent String?  @db.Text @map("user_agent")

  createdAt DateTime @default(now()) @map("created_at")

  // Municipality the action belongs to (set for municipal admin actions).
  municipalityId String? @map("municipality_id")

  @@index([municipalityId, createdAt])
  @@map("audit_logs")
}

// ============================================
// MESSAGING (buyer <-> store)
// ============================================

model Conversation {
  id        String   @id @default(uuid())

  buyerId   String   @map("buyer_id")
  buyer     User     @relation("BuyerConversations", fields: [buyerId], references: [id])

  storeId   String   @map("store_id")
  store     Store    @relation(fields: [storeId], references: [id])

  lastMessageAt    DateTime? @map("last_message_at")
  buyerLastReadAt  DateTime? @map("buyer_last_read_at")
  sellerLastReadAt DateTime? @map("seller_last_read_at")

  // Buyer's rating of the seller's customer service for this conversation
  serviceRating   Int?      @map("service_rating")
  serviceRatingAt DateTime? @map("service_rating_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  messages  Message[]

  @@unique([buyerId, storeId])
  @@index([storeId, lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())

  conversationId String       @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  senderId  String   @map("sender_id")
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])

  body      String   @db.Text
  imageUrl  String?  @map("image_url")

  // Optional link to an order this message references (used for auto-pinned order cards)
  orderId   String?  @map("order_id")
  order     Order?   @relation(fields: [orderId], references: [id])

  // Optional link to a product the buyer is asking about
  productId String?  @map("product_id")
  product   Product? @relation(fields: [productId], references: [id])

  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================
// RETURN / REFUND REQUESTS
// ============================================

model ReturnRequest {
  id            String   @id @default(uuid())
  requestNumber String   @unique @map("request_number")

  orderId       String   @map("order_id")
  order         Order    @relation("OrderReturns", fields: [orderId], references: [id])

  buyerId       String   @map("buyer_id")
  buyer         User     @relation("BuyerReturns", fields: [buyerId], references: [id])

  storeId       String   @map("store_id")
  store         Store    @relation("StoreReturns", fields: [storeId], references: [id])

  status        ReturnStatus @default(REQUESTED)
  reason        ReturnReason
  buyerNote     String?  @db.Text @map("buyer_note")
  sellerNote    String?  @db.Text @map("seller_note")
  photos        Json?

  requestedAmount Decimal  @db.Decimal(10, 2) @map("requested_amount")
  approvedAmount  Decimal? @db.Decimal(10, 2) @map("approved_amount")
  refundedAmount  Decimal? @db.Decimal(10, 2) @map("refunded_amount")

  refundMethod    RefundMethod? @map("refund_method")
  refundReference String?       @map("refund_reference")

  requiresPhysicalReturn Boolean @default(true) @map("requires_physical_return")
  returnPolicySnapshot   Json?   @map("return_policy_snapshot")
  history                Json?

  decidedAt   DateTime? @map("decided_at")
  decidedBy   String?   @map("decided_by")
  receivedAt  DateTime? @map("received_at")
  refundedAt  DateTime? @map("refunded_at")
  closedAt    DateTime? @map("closed_at")
  cancelledAt DateTime? @map("cancelled_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  items ReturnRequestItem[]

  @@index([orderId])
  @@index([buyerId])
  @@index([storeId, status])
  @@map("return_requests")
}

model ReturnRequestItem {
  id              String @id @default(uuid())
  returnRequestId String @map("return_request_id")
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Cascade)

  orderItemId String    @map("order_item_id")
  orderItem   OrderItem @relation("OrderItemReturns", fields: [orderItemId], references: [id])

  quantity     Int
  unitPrice    Decimal @db.Decimal(10, 2) @map("unit_price")
  subtotal     Decimal @db.Decimal(10, 2)

  restockOnReceive Boolean @default(false) @map("restock_on_receive")

  createdAt DateTime @default(now()) @map("created_at")

  @@index([orderItemId])
  @@map("return_request_items")
}

// ==================== BANNERS ====================

enum BannerPlacement {
  HOME_CAROUSEL
  HOME_SIDEBAR_TOP
  HOME_SIDEBAR_BOTTOM
  HOME_POPUP
}

model Banner {
  id          String   @id @default(uuid())
  title       String
  subtitle    String?  @db.Text
  imageUrl    String   @map("image_url")
  linkUrl     String?  @map("link_url")
  placement   BannerPlacement @default(HOME_CAROUSEL)
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdById String?  @map("created_by_id")
  createdBy   User?    @relation("BannerCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([placement, isActive, sortOrder])
  @@map("banners")
}

// ==================== VOUCHERS ====================

enum VoucherDiscountType {
  PERCENT
  FIXED
}

model Voucher {
  id              String              @id @default(uuid())
  code            String              @unique
  description     String?             @db.Text
  discountType    VoucherDiscountType @map("discount_type")
  discountValue   Decimal             @db.Decimal(10, 2) @map("discount_value")
  minOrderAmount  Decimal?            @db.Decimal(10, 2) @map("min_order_amount")
  maxDiscount     Decimal?            @db.Decimal(10, 2) @map("max_discount")
  usageLimit      Int?                @map("usage_limit")
  perUserLimit    Int?                @default(1) @map("per_user_limit")
  timesUsed       Int                 @default(0) @map("times_used")
  startsAt        DateTime?           @map("starts_at")
  expiresAt       DateTime?           @map("expires_at")
  isActive        Boolean             @default(true) @map("is_active")
  createdById     String?             @map("created_by_id")
  createdBy       User?               @relation("VoucherCreator", fields: [createdById], references: [id])
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  redemptions VoucherRedemption[]
  orders      Order[]

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("vouchers")
}

model VoucherRedemption {
  id             String   @id @default(uuid())
  voucherId      String   @map("voucher_id")
  voucher        Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id])
  orderId        String   @unique @map("order_id")
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  discountAmount Decimal  @db.Decimal(10, 2) @map("discount_amount")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([voucherId, userId])
  @@map("voucher_redemptions")
}
