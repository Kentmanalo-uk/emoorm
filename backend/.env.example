# ============================================
# E-MOORM Backend Environment Configuration
# Copy this file to .env and update the values
# ============================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
API_PREFIX=/api

# Database Configuration (MySQL via Laragon)
DATABASE_URL="mariadb://emoorm_app:REPLACE_WITH_PASSWORD@localhost:3306/emoorm_db"

# JWT Configuration
JWT_SECRET=generate-a-random-32-byte-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate-a-different-random-32-byte-secret
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:19006
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:8081

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp

# Cloudinary Configuration (Optional - for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email — password resets and notifications
# ---------------------------------------------------------------------------
# Preferred: Resend's HTTP API. Create a key at https://resend.com/api-keys.
# A rejected send returns a real error here, so a dropped recipient shows up
# in the logs instead of vanishing behind an SMTP "250 OK".
RESEND_API_KEY=

# Who the mail comes from. Until you verify a domain, Resend only accepts
# its shared sandbox sender:
#
#   RESEND_FROM="E-MOORM <onboarding@resend.dev>"
#
# The sandbox sender ONLY delivers to the address that owns the Resend
# account. Every other recipient is accepted and silently discarded, so
# password resets will appear to work and reach nobody. To send to real
# users, add a domain at https://resend.com/domains, publish the DKIM and
# SPF records it gives you, then switch this to an address on that domain:
#
#   RESEND_FROM="E-MOORM <noreply@yourdomain.ph>"
RESEND_FROM=

# Fallback: any plain SMTP provider, used only when RESEND_API_KEY is unset.
# For Resend over SMTP: host smtp.resend.com, user "resend", password = the
# same API key. With neither configured, mail is written to the server
# console and the reset link is printed there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@emoorm.com

# Frontend URL — used to build links in outgoing emails.
# MUST be set in production: a reset link built from the default points at
# the recipient's own machine, not at your site.
FRONTEND_URL=http://localhost:5173

# Google OAuth (Continue with Google)
# The client secret must NEVER be committed or exposed to the client bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
BODY_LIMIT=1mb

# Identity verification (OCR of government ID before checkout)
# 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_ENCRYPTION_KEY=
IDENTITY_VERIFICATION_REQUIRED=true
# 0 = unlimited
IDENTITY_MAX_ATTEMPTS_PER_DAY=5
OCR_CACHE_PATH=.ocr-cache

# ── Caching ──────────────────────────────────────────────────────────
# Redis is optional. Without CACHE_REDIS_URL the API uses an in-process
# cache; if Redis is configured but unreachable, requests fall back to the
# database rather than failing. The startup banner prints which cache is in
# use, and GET /health reports the driver, hit rate and error count — so a
# missing Redis is never a silent surprise.
#
#   npm run redis       start it with this project's cache settings
#                       (256MB ceiling, LRU eviction, no persistence —
#                        see redis.conf; the defaults are wrong for a cache)
#   npm run redis:cli   inspect it
#   npm run test:redis  verify keys, TTLs, invalidation and eviction
#
# On Laragon the binary is found automatically. Elsewhere, put redis-server
# on PATH or set REDIS_SERVER_PATH / REDIS_CLI_PATH.
CACHE_REDIS_URL=redis://127.0.0.1:6379
CACHE_ENABLED=true
CACHE_NAMESPACE=emoorm
# Bump CACHE_VERSION to invalidate every cached entry at once (e.g. after a
# response-shape change in a deploy).
CACHE_VERSION=1

# Optional CDN in front of /uploads. When set, upload responses return
# absolute CDN URLs so images are not served through the API.
# CDN_URL=https://cdn.example.com

# Delete KYC documents this many days after an application is decided.
KYC_RETENTION_DAYS=90
