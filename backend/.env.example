# ============================================
# E-MOORM Backend Environment Configuration
# Copy this file to .env and update the values
# ============================================

# Node Environment
NODE_ENV=development

# Server Configuration
PORT=3000
API_PREFIX=/api

# Database Configuration (MySQL via Laragon)
DATABASE_URL="mariadb://emoorm_app:REPLACE_WITH_PASSWORD@localhost:3306/emoorm_db"

# JWT Configuration
JWT_SECRET=generate-a-random-32-byte-secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=generate-a-different-random-32-byte-secret
JWT_REFRESH_EXPIRES_IN=30d

# Bcrypt Configuration
BCRYPT_ROUNDS=10

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:19006
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:19006,http://localhost:8081

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads
ALLOWED_FILE_TYPES=image/jpeg,image/jpg,image/png,image/webp

# Cloudinary Configuration (Optional - for production)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email Configuration (Optional - for notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@emoorm.com

# Frontend URL — used to build links in outgoing emails
FRONTEND_URL=http://localhost:5173

# Google OAuth (Continue with Google)
# The client secret must NEVER be committed or exposed to the client bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=600
BODY_LIMIT=1mb

# Identity verification (OCR of government ID before checkout)
# 32-byte key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IDENTITY_ENCRYPTION_KEY=
IDENTITY_VERIFICATION_REQUIRED=true
# 0 = unlimited
IDENTITY_MAX_ATTEMPTS_PER_DAY=5
OCR_CACHE_PATH=.ocr-cache
